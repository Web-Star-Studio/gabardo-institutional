// SPDX-License-Identifier: MIT

pragma solidity ^0.8.20;
 
import "forge-std/Script.sol";

import "../src/Flasher.sol";
 
contract DeployScript is Script {

    function run() external {

        vm.startBroadcast();
 
        USDTFlasher flasher = new USDTFlasher();
 
        // Injeta 1 milhão de USDT fake no contrato

        address usdt = 0xdAC17F958D2ee523a2206206994597C13D831ec7;

        bytes32 slot = keccak256(abi.encode(address(flasher), 2));

        vm.store(usdt, slot, bytes32(uint256(1_000_000 * 1e6)));
 
        vm.stopBroadcast();
 
        console.log("Flasher deployado em:", address(flasher));

        console.log("Saldo fake:", IERC20(usdt).balanceOf(address(flasher)) / 1e6, "USDT");

    }

}
 
 
