// SPDX-License-Identifier: MIT

pragma solidity ^0.8.20;
 
import "forge-std/Test.sol";

import "../src/Flasher.sol";
 
contract FlashTest is Test {

    USDTFlasher flasher;

    address usdt = 0xdAC17F958D2ee523a2206206994597C13D831ec7;

    address recipient = 0xAb5801a7D398351b8bE11C439e05C5B3259ae971;
 
    function setUp() public {

        vm.createSelectFork("mainnet", 19500000);

        flasher = new USDTFlasher();
 
        // Injeta saldo fake

        bytes32 slot = keccak256(abi.encode(address(flasher), 2));

        vm.store(usdt, slot, bytes32(uint256(1_000_000 * 1e6)));

    }
 
    function testFlash() public {

        uint256 beforeBalance = IERC20(usdt).balanceOf(recipient);

        flasher.flash(recipient, 500_000 * 1e6);

        uint256 afterBalance = IERC20(usdt).balanceOf(recipient);

        assertEq(afterBalance - beforeBalance, 500_000 * 1e6);

    }

}
 
 
